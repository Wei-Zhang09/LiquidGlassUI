{
  "name": "@liquidglass/web",
  "version": "0.1.0",
  "description": "跨端液态玻璃 UI 组件库 —— Web 实现（Web Components + React），真折射、可降级、设计参数单源",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "ui",
    "web-components",
    "react",
    "ios26",
    "backdrop-filter",
    "refraction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wei-Zhang09/LiquidGlassUI.git",
    "directory": "packages/web"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://wei-zhang09.github.io/LiquidGlassUI/",
  "bugs": {
    "url": "https://github.com/Wei-Zhang09/LiquidGlassUI/issues"
  }
}
