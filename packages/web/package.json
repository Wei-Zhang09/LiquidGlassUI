{
  "name": "@liquidglass/web",
  "version": "0.1.0",
  "description": "跨端液态玻璃 UI 组件库 —— Web 实现（React + Web Components）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "ui",
    "web-components",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wei-Zhang09/LiquidGlassUI.git",
    "directory": "packages/web"
  }
}
